  {
    "id": "g7p1_esc",
    "type": "function",
    "z": "g7p1_tab",
    "name": "Escalar sensores",
    "func": "const r = msg.payload.data;                // los 16 registros que llegan del gemelo (vienen dentro de \"data\")\nlet salida = {};\nsalida[\"pos_pieza_pct\"] = Math.round((0 + r[0] * (100 - 0) / 4095) * 100) / 100;   // la regla de tres, con 2 decimales\nsalida[\"temp_husillo_C\"] = Math.round((0 + r[1] * (120 - 0) / 4095) * 100) / 100;   // la regla de tres, con 2 decimales\nsalida[\"vibracion_mm_s\"] = Math.round((0 + r[2] * (10 - 0) / 4095) * 100) / 100;   // la regla de tres, con 2 decimales\nsalida[\"corriente_banda_A\"] = Math.round((0 + r[3] * (5 - 0) / 4095) * 100) / 100;   // la regla de tres, con 2 decimales\nmsg.payload = salida;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 100,
    "wires": [
      [
        "g7p1_dbg",
        "g7p1_gauge",
        "g7p1_chart"
      ]
    ]
  },
